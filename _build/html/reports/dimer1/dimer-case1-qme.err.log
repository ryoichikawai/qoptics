g2 = G2/I_sum**2

g2_exact = 1-np.exp(-(gamma0)*times)

plt.figure(figsize=(4,3))
plt.plot(times*gamma0, np.real(g2),c='r',label="pair")
plt.plot(-times*gamma0,np.real(g2),c='r')
plt.plot(times*gamma0, np.real(g2_exact),c='k',ls='--',label="single")
plt.plot(-times*gamma0, np.real(g2_exact),c='k',ls='--')
plt.xlabel(r'$\tau\gamma_{0}$')
plt.ylabel(r'$g^{(2)}(\tau)$')
plt.legend(loc=4)
plt.grid(True)
